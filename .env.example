# Copy this file to .env and fill in your key(s).

# DeepL API key (https://www.deepl.com/pro-api). Free tier: 500k chars/month.
DEEPL_API_KEY=

# Optional Google Cloud Translation API key.
GOOGLE_API_KEY=

# Optional API key for the LLM endpoint (--provider llm). chat2api on
# localhost usually needs none; leave empty if your server is open.
LLM_API_KEY=
